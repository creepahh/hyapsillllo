{
  "manifest_version": 3,
  "name": "Hyapsilo Notes",
  "version": "1.0",
  "description": "A small floating notes app.",

  "permissions": [
    "storage"
  ],

  "icons": {
    "16": "hyapsiloimg.png",
    "32": "hyapsiloimg.png",
    "48": "hyapsiloimg.png",
    "128": "hyapsiloimg.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Hyapsilo Notes",
    "default_icon": {
      "16": "hyapsiloimg.png",
      "32": "hyapsiloimg.png",
      "48": "hyapsiloimg.png",
      "128": "hyapsiloimg.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "commands": {
    "open-notes": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Open Hyapsilo Notes"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
